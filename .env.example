OPENAI_API_KEY=
SSGAI_MODEL=gpt-5-mini
SSGAI_MAX_TURNS=3
SSGAI_AGENT_RELEASE_ID=ssgai-free-audit-dev-1
SSGAI_REVIEW_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
HUBSPOT_ACCESS_TOKEN=
# LEAD_WEBHOOK_URL stays empty. The lead webhook is off unless LEAD_WEBHOOK_AUTHORIZED=true.
LEAD_WEBHOOK_URL=
NEXT_PUBLIC_FULL_AUDIT_URL=/contact
# --- Phase 2B lead automation (all optional; nothing runs unless LEAD_AUTOMATION_ENABLED=true)
LEAD_AUTOMATION_ENABLED=false
HUBSPOT_DEFAULT_OWNER_ID=
HUBSPOT_PORTAL_ID=246622244
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Task identity is the stored submission key plus one open HubSpot task. There is no search window.
LEAD_TASK_DUE_HOURS=24
LEAD_EXCLUDED_COMPANY_DOMAINS=
# Optional secondary email notification via Resend (free tier).
# NOTIFY_EMAIL_FROM must be an address on the SSG domain, for example
# SSG <notify@shipleysolutionsgroup.com>. Leave it empty until Resend domain
# authentication (SPF and DKIM) is in place and a delivery test has passed.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Unused by the intake pipeline. The current submission runs in the request; retries use the scheduled function.
LEAD_AUTOMATION_BUDGET_MS=5000
# Optional: HMAC-sign the LEAD_WEBHOOK_URL POST. The intake webhook body is always the allowlist (no message or phone).
LEAD_WEBHOOK_SECRET=
# Set true only to add email and first name to the signed webhook body.
LEAD_WEBHOOK_INCLUDE_CONTACT=false
# Lead webhook stays off unless this is the literal true, the URL is https, and the secret is at least 32 characters.
LEAD_WEBHOOK_AUTHORIZED=false
# Live calls require a production build AND one of these request hosts.
# ssg-site.netlify.app is the production deploy's own Netlify address.
# Mock and live-test never run on these hosts. A missing or broken list cannot remove them.
LEAD_PRODUCTION_HOSTS=shipleysolutionsgroup.com,www.shipleysolutionsgroup.com,ssg-site.netlify.app
# Non-production opt-in. Uses only the TEST credentials below and never HUBSPOT_ACCESS_TOKEN.
# Hard-fails when HUBSPOT_TEST_PORTAL_ID is the production portal 246622244. Webhook stays off.
LEAD_LIVE_TEST=false
HUBSPOT_TEST_ACCESS_TOKEN=
HUBSPOT_TEST_PORTAL_ID=
RESEND_TEST_API_KEY=
NOTIFY_EMAIL_TEST_TO=
NOTIFY_EMAIL_TEST_FROM=
# Live-test owner. Production fallback is HUBSPOT_DEFAULT_OWNER_ID. Never create an unassigned task.
HUBSPOT_TEST_DEFAULT_OWNER_ID=
# Optional map of project_type label to a numeric HubSpot owner id.
OWNER_ROUTING_JSON=
# 32-byte key, base64. Without it, submissions are not stored and a HubSpot failure stays a 502.
LEAD_STORE_KEY=
# At least 32 characters. Rate-limit identity is an HMAC of IP and email. Missing salt fails open.
LEAD_HASH_SALT=
LEAD_MAX_ATTEMPTS=6
LEAD_RETENTION_DONE_DAYS=14
LEAD_RETENTION_DLQ_DAYS=30
LEAD_MIN_FILL_MS=2500
LEAD_RL_IP_PER_10M=5
LEAD_RL_EMAIL_PER_10M=3
LEAD_RL_GLOBAL_PER_10M=60
LEAD_CONSENT_VERSION=2026-10-v1
LEAD_LOCK_RETRY_MS=2000
# Production-live SMTP fallback when Resend is unset. Not used for live-test.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
